# Copy to .env or point APP_KEYS_FILE at your private keys file.
# Never commit real keys.

# Preferred: absolute path to private keys (e.g. RAP_LLM_KEYS.env)
APP_KEYS_FILE=

# Or set keys directly:
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# gemini = Gemini first, then Groq (default). groq = Groq first.
LLM_PRIMARY=gemini
# Attempts per completion. 2 = primary model, then the other provider.
LLM_MAX_ATTEMPTS=2
# Whole-request ceiling. The happy path returns on the first successful call.
REQUEST_DEADLINE_SEC=28
# Optional Tesseract OCR for near-empty pages. Off keeps text-PDF ingest local and fast.
SIXCALL_OCR=0
# Optional second LLM call to plan keywords. Off uses the local heuristic planner.
SIXCALL_LLM_PLANNER=0
# 0 = local JSON store (CLI default). 1 = also use DATABASE_URL. auto = DB when configured.
SIXCALL_USE_DB=auto

# Optional disk cache for parsed docs
DOC_STORE_DIR=.data/docs
MAX_TOOL_CALLS=6

# Supabase / Postgres
# Prefer Session pooler (IPv4). Direct db.*.supabase.co is often IPv6-only.
# User form for pooler: postgres.<project-ref>
# Percent-encode password special chars (@ -> %40)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
