# Copy to .env or point APP_KEYS_FILE at your private keys file.
# Never commit real keys.

# Preferred: absolute path to private keys (e.g. RAP_LLM_KEYS.env)
APP_KEYS_FILE=

# Or set keys directly:
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# groq = prefer Groq first (recommended while Gemini is rate-limited)
# gemini = prefer Gemini first, Groq fallback
LLM_PRIMARY=groq

# Optional disk cache for parsed docs
DOC_STORE_DIR=.data/docs
MAX_TOOL_CALLS=6

# CLI demo stays on local JSON even if DATABASE_URL is set.
SIXCALL_USE_DB=0
# Chat-memory answers are off. A zero-tool result is sent back through the tools.
SIXCALL_FOLLOWUPS=0

# Supabase / Postgres — SOURCE OF TRUTH for documents (not local JSON).
# Prefer Session pooler (IPv4). Direct db.*.supabase.co is often IPv6-only.
# User form for pooler: postgres.<project-ref>
# Percent-encode password special chars (@ -> %40)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Read/auth timeout (ms). Ingest uses DB_WRITE_TIMEOUT_MS (large PDFs need minutes).
DB_STATEMENT_TIMEOUT_MS=15000
DB_WRITE_TIMEOUT_MS=180000
DB_CONNECT_TIMEOUT_SEC=5

# Page text: 0 = plain PyMuPDF (fast, default). 1 = pymupdf4llm markdown (tables,
# slower — ~2–3 min for a 600-page textbook). Use 1 for judging quality runs.
# SIXCALL_MARKDOWN_EXTRACT=0

# OCR is off by default (slow). Set 1 only for scanned/image PDFs.
# SIXCALL_OCR=0

# auto = use Postgres whenever DATABASE_URL is set (recommended).
# 0 = force local JSON only (tests / offline). Never leave this on 0 in demo.
SIXCALL_USE_DB=auto
