# Copy to .env or point APP_KEYS_FILE at your private keys file.
# Never commit real keys.

# Preferred: absolute path to private keys (e.g. RAP_LLM_KEYS.env)
APP_KEYS_FILE=

# Or set keys directly:
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# groq = prefer Groq first (recommended while Gemini is rate-limited)
# gemini = prefer Gemini first, Groq fallback
LLM_PRIMARY=groq

# Optional disk cache for parsed docs
DOC_STORE_DIR=.data/docs
MAX_TOOL_CALLS=6

# Supabase / Postgres
# Prefer Session pooler (IPv4). Direct db.*.supabase.co is often IPv6-only.
# User form for pooler: postgres.<project-ref>
# Percent-encode password special chars (@ -> %40)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
